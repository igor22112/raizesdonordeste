# Variáveis de ambiente do docker-compose.yml.
# Uso: copie este arquivo para ".env" (cp .env.example .env  |  Windows: copy .env.example .env) e ajuste os valores.
# Sem o arquivo .env, o docker-compose usa os mesmos valores padrão abaixo (somente para desenvolvimento).
# NUNCA versione o arquivo .env com segredos reais (ele já está no .gitignore).

# Senha do usuário "sa" do SQL Server (mínimo 8 caracteres, com maiúscula, minúscula, número e símbolo)
SQL_SA_PASSWORD=Raizes_Dev_2026!

# Chave de assinatura do JWT (mínimo 32 caracteres)
JWT_KEY=chave-de-desenvolvimento-docker-nao-usar-em-producao-123

# Integração com o gateway de pagamento simulado (API key e segredo HMAC do webhook)
GATEWAY_API_KEY=gateway-dev-api-key
WEBHOOK_SECRET=segredo-webhook-desenvolvimento

# Administrador inicial da matriz (criado no primeiro start)
ADMIN_EMAIL=admin@raizes.com.br
ADMIN_PASSWORD=Raizes@2026

# Limite de requisições por usuário/IP a cada 10 segundos
RATE_LIMIT=200
