{
  "ConnectionStrings": {
    "SqlServer": "Server=localhost,1433;Database=RaizesDoNordeste;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;Encrypt=True"
  },
  "Jwt": {
    "Emissor": "raizes-do-nordeste",
    "Audiencia": "raizes-do-nordeste-api",
    "Chave": "",
    "ExpiracaoMinutos": 60
  },
  "GatewayPagamento": {
    "BaseUrl": "http://localhost:5100/",
    "ApiKey": "",
    "UrlCallback": "http://localhost:5000/api/v1/webhooks/pagamentos",
    "SegredoWebhook": "",
    "TimeoutTentativaSegundos": 3,
    "TimeoutTotalSegundos": 10,
    "MaxRetentativas": 2
  },
  "Pedidos": {
    "PrazoPagamentoMinutos": 15,
    "ToleranciaPagamentoPendenteMinutos": 10
  },
  "Privacidade": {
    "VersaoTermoAtual": "1.0"
  },
  "Jobs": {
    "Habilitados": true,
    "IntervaloOutboxSegundos": 5,
    "IntervaloExpiracaoSegundos": 60
  },
  "Seed": {
    "AplicarMigracoes": true,
    "DadosDemonstracao": false
  },
  "RateLimit": {
    "RequisicoesPorJanela": 200,
    "JanelaSegundos": 10,
    "LoginPorMinuto": 10
  },
  "Cache": {
    "CardapioSegundos": 15
  },
  "Cors": {
    "Origens": [ "http://localhost:3000", "http://localhost:5173" ]
  },
  "Documentacao": {
    "Habilitada": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelacaoId} {SourceContext}: {Message:lj}{NewLine}{Exception}" }
      }
    ]
  },
  "AllowedHosts": "*"
}
